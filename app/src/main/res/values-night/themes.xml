<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NallaNudi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/slate_100</item>
        <item name="android:windowBackground">@color/slate_900</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="StatusText">
        <item name="android:textColor">@color/slate_400</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="HeadingMain">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="SubHeading">
        <item name="android:textColor">@color/indigo_200</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>
</resources>
