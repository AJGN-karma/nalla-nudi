<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NallaNudi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/slate_900</item>
        <item name="android:windowBackground">@color/slate_100</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="StatusText">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/slate_400</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="HeadingMain">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/slate_900</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="SubHeading">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/indigo_600</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>
</resources>
